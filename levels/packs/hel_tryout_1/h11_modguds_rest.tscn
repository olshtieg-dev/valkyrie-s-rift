[node name="Modgud" type="Area2D" parent="." unique_id=1056891006]
script = ExtResource("7_3e2t0")
npc_name = "Modgud"
lines = PackedStringArray("Another one falls, and this one still breathes. I am Modgud. I keep the road of the dead.", "The dead come down. They never climb up. Yet here you are, wings broken, climbing.", "Above this hall lies Garmr\'s den. The hound guards the gate, and it has never let anyone leave.", "Strike when it lunges and misses. Even a hound of Hel has to catch its breath.", "Go, small one. If you break out, tell the world tree that Hel remembers you.")
sheet = ExtResource("8_kb807")
